+# ---------- Opportunities: public browse (student-facing) ----------
+
+def _serialize_opportunity_public(opp, org):
+    """
+    Slimmer than _serialize_opportunity() (which is for the org's own
+    management view) - omits internal review fields (rejection_reason,
+    reviewed_at/by, submitted_at) that students have no reason to see.
+    """
+    return {
+        "id": opp.id,
+        "organisation_id": opp.organisation_id,
+        "organisation_name": org.name if org else None,
+        "organisation_logo_url": org.logo_url if org else None,
+        "title": opp.title,
+        "description": opp.description,
+        "opportunity_type": opp.opportunity_type,
+        "location": opp.location,
+        "is_remote": opp.is_remote,
+        "application_url": opp.application_url,
+        "application_instructions": opp.application_instructions,
+        "application_deadline": opp.application_deadline.isoformat() if opp.application_deadline else None,
+        "expiry_date": opp.expiry_date.isoformat() if opp.expiry_date else None,
+        "published_at": opp.published_at.isoformat() if opp.published_at else None,
+        "view_count": opp.view_count,
+    }
+
