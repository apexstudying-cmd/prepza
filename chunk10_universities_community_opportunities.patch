+@app.route("/opportunities")
+def browse_opportunities():
+    """
+    Public browse of live opportunities - published, not yet expired,
+    and belonging to an org that's still verified and active (an org
+    losing verification/activation after publishing shouldn't leave
+    its old postings visible). Expiry is computed on read against
+    expiry_date rather than swept by a background job, same as
+    get_user_subscription_status() does for subscriptions elsewhere.
+    """
+    user_id = session.get("user_id")
+    if not user_id:
+        return jsonify({"error": "Not logged in"}), 401
+
+    now = datetime.utcnow()
+    query = (
+        Opportunity.query
+        .join(Organisation, Opportunity.organisation_id == Organisation.id)
+        .filter(
+            Opportunity.status == "published",
+            Opportunity.expiry_date > now,
+            Organisation.verification_status == "verified",
+            Organisation.is_active.is_(True),
+        )
+    )
+
+    opportunity_type = request.args.get("opportunity_type")
+    if opportunity_type:
+        if opportunity_type not in OPPORTUNITY_TYPES:
+            return jsonify({"error": "opportunity_type must be one of: " + ", ".join(OPPORTUNITY_TYPES)}), 400
+        query = query.filter(Opportunity.opportunity_type == opportunity_type)
+
+    if request.args.get("is_remote") is not None:
+        query = query.filter(Opportunity.is_remote.is_(request.args.get("is_remote").lower() == "true"))
+
+    q = (request.args.get("q") or "").strip()
+    if q:
+        query = query.filter(Opportunity.title.ilike(f"%{q}%"))
+
+    try:
+        page = max(1, int(request.args.get("page", 1)))
+    except ValueError:
+        page = 1
+    per_page = 20
+
+    opportunities = (
+        query.order_by(Opportunity.published_at.desc())
+        .offset((page - 1) * per_page)
+        .limit(per_page)
+        .all()
+    )
+
+    org_ids = [o.organisation_id for o in opportunities]
+    orgs = {
+        org.id: org for org in Organisation.query.filter(Organisation.id.in_(org_ids)).all()
+    } if org_ids else {}
+
+    return jsonify({
+        "page": page,
+        "opportunities": [
+            _serialize_opportunity_public(o, orgs.get(o.organisation_id)) for o in opportunities
+        ],
+    })
+
+
+@app.route("/opportunities/<int:opportunity_id>")
+def get_opportunity(opportunity_id):
+    """
+    Detail view for a single live opportunity - same visibility rules
+    as browse_opportunities(), plus a view_count bump on each fetch.
+    """
+    user_id = session.get("user_id")
+    if not user_id:
+        return jsonify({"error": "Not logged in"}), 401
+
+    opp = db.session.get(Opportunity, opportunity_id)
+    if not opp or opp.status != "published" or opp.expiry_date <= datetime.utcnow():
+        return jsonify({"error": "Opportunity not found"}), 404
+
+    org = db.session.get(Organisation, opp.organisation_id)
+    if not org or org.verification_status != "verified" or not org.is_active:
+        return jsonify({"error": "Opportunity not found"}), 404
+
+    opp.view_count = (opp.view_count or 0) + 1
+    db.session.commit()
+
+    return jsonify(_serialize_opportunity_public(opp, org))
+
