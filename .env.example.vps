POSTGRES_DB=prepza
POSTGRES_USER=prepza
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_URL_SAFE_PASSWORD

# Flask/session
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
BASE_URL=https://YOUR_DOMAIN

# PostgreSQL
DATABASE_URL=postgresql://prepza:CHANGE_ME@POSTGRES_HOST:5432/prepza

# Supabase compatibility storage (used when PREPZA_R2_* is not configured)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis: shared rate limiting, realtime fan-out and durable chat event queue
REDIS_URL=

# Transactional email
AWS_SES_REGION=
SES_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI
OPENAI_API_KEY=
# Process-local AI worker recovery window. Lower values make stuck jobs visible sooner;
# this is not a durable queue and does not create any external infrastructure.
AI_JOB_STALE_AFTER_SECONDS=3600

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Error monitoring
SENTRY_DSN=

# Cloudflare R2 / S3-compatible object storage
# Logical buckets are prefixed inside the physical R2 bucket by object_storage.py.
PREPZA_R2_ENDPOINT=
PREPZA_R2_ACCESS_KEY_ID=
PREPZA_R2_SECRET_ACCESS_KEY=
PREPZA_R2_BUCKET=

# Kokoro worker/control plane
KOKORO_WORKER_TOKEN=
KOKORO_CONTROL_TOKEN=
PREPZA_INTERNAL_BASE_URL=

# Optional Vast/Kokoro autoscaling controls.
# Keep the autoscaler in dry-run/manual mode until explicitly enabled.
VAST_API_KEY=
VAST_API_BASE_URL=https://console.vast.ai/api/v0
VAST_GPU_NAME=RTX_A2000
VAST_GPU_CANDIDATES=RTX_A2000
VAST_MAX_DPH_USD=0.10
VAST_MAX_GPU_HOURLY_SPEND_USD=0.10
VAST_MIN_PROVIDER_CREDIT_RESERVE_USD=5.00
KOKORO_AUTOSCALER_DRY_RUN=true
KOKORO_SCALING_MODE=manual
